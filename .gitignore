# ---------------------------------------------------------------------------
# CS2 Win Probability Model — gitignore
# Large data artifacts and binaries are NOT tracked. Code + small CSVs are.
# Directory structure is preserved via .gitkeep files (force-kept below).
# ---------------------------------------------------------------------------

# --- Demos (huge .rar / .dem files, ~hundreds of GB) ---
demos/raw/*
demos/extracted/*

# --- Parsed parquet channels ---
data/parquet/**/*.parquet
data/parquet/**/*.pq

# --- Engineered features ---
features/**/*.parquet
features/**/*.pq

# --- Final training/test datasets ---
data/*.parquet
data/training_dataset.parquet

# --- Trained models / checkpoints ---
models/*.pkl
models/*.pt
models/*.pth
models/*.cbm
models/*.json
models/*.txt
checkpoints/
*.ckpt

# --- Outputs / figures (regenerable) ---
outputs/figures/*
!outputs/figures/.gitkeep
# Paper figures ARE tracked: they are the deliverable, small, and must be
# reviewable alongside the draft without re-running the pipeline.
!outputs/figures/paper/
!outputs/figures/paper/*.png

# --- OOF prediction dumps (large, regenerable) ---
outputs/oof_*.parquet

# --- Logs ---
*.log
failed_demos.txt

# --- Local caches (e.g. Liquipedia wikitext) ---
.cache/

# --- Keep directory placeholders everywhere ---
!**/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.conda/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local working notes, kept out of the public record
# ---------------------------------------------------------------------------
preprocess.md
process.md
*.docx

# ---------------------------------------------------------------------------
# Secrets / credentials
# ---------------------------------------------------------------------------
.env
*.pem
*.key
secrets.*

# share bundles (upload to Drive, never to git)
*.zip
cs2_share_bundle.zip

# --- 2026 out-of-time holdout raw channels (isolated from training; regenerable from the bundle) ---
data/holdout2026/
outputs/pathwise_perround_*.parquet

# --- Wyner export packages (exports/) ---
# The bulk data is fully reproducible from src/data/build_wyner_export.py and
# build_wyner_supplement.py, so only the documentation + manifest are tracked.
exports/**/*.parquet
exports/**/*.csv

# --- uploaded Wyner supplement package (330 MB of parquet; never commit) ---
data/cs2_inferno_raw_supplement_v1/
data/holdout2026/
data/parquet_defuse/
outputs/t0_round_table.parquet

# --- study outputs that are regenerable and large (map_wp / t0 pilot parquet dumps) ---
outputs/*.parquet
# third-party paper PDF kept locally for reference, not redistributed
"JQAS WP Model Football Paper.pdf"
JQAS*.pdf

# --- private correspondence drafts (never commit) ---
docs/**/email_*.md
docs/email_*.md
